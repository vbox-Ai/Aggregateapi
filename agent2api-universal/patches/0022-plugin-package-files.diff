+// ── 插件文件桥（iOS：宿主跑在手机里，插件的文件却在这台网关上）──────────────
+//
+// 手机里的宿主收到 init 之后，会用 `entry.directory` 去读插件的 `package.json` 与入口
+// 文件，而那个目录是**网关本机**的路径（`script/storage.rs::directory`）—— 手机读不到。
+// 所以在把 init 交给宿主之前，手机按包 id 把这些文件取回去、登记进自己的文件表。
+//
+// 只回文本：脚本插件是 JS 包，图标是 URL，不需要字节流；二进制文件（解不出来）与
+// 超出预算的文件直接跳过 —— 漏文件的表现是宿主报错，不是静默成功。
+
+/// 单包最多回多少文件（正常包几十个）
+const PACKAGE_FILES_MAX: usize = 4096;
+/// 单包最多回多少字节（正常包几百 KB）
+const PACKAGE_BYTES_MAX: usize = 8 << 20;
+
+#[derive(Deserialize)]
+pub struct PackageFilesBody {
+    /// 插件包 id（`script/storage.rs` 里的 `Package::id`）
+    id: String,
+}
+
+/// 按包 id 返回该插件包的全部文本文件（相对包根目录的路径 + 内容）。
+pub async fn package_files(
+    State(_state): State<ServerState>,
+    _headers: HeaderMap,
+    Json(body): Json<PackageFilesBody>,
+) -> Response {
+    let id = body.id.trim().to_string();
+    if id.is_empty() {
+        return error_response("缺少插件包 id", StatusCode::BAD_REQUEST);
+    }
+    let registry = match script::read_registry() {
+        Ok(registry) => registry,
+        Err(error) => {
+            return error_response(
+                &format!("读取脚本插件注册表失败：{error}"),
+                StatusCode::INTERNAL_SERVER_ERROR,
+            )
+        }
+    };
+    let Some(package) = registry.packages.iter().find(|package| package.id == id) else {
+        return error_response(&format!("没有这支脚本插件：{id}"), StatusCode::NOT_FOUND);
+    };
+    let directory = match script::package_directory(package) {
+        Ok(directory) => directory,
+        Err(error) => return error_response(&error, StatusCode::INTERNAL_SERVER_ERROR),
+    };
+    let mut files: Vec<serde_json::Value> = Vec::new();
+    let mut budget = PACKAGE_BYTES_MAX;
+    if let Err(error) = collect_package_files(&directory, &directory, &mut files, &mut budget) {
+        return error_response(
+            &format!("读取插件文件失败：{error}"),
+            StatusCode::INTERNAL_SERVER_ERROR,
+        );
+    }
+    ok_json(json!({ "id": id, "files": files }))
+}
+
+/// 递归收文本文件：`path` 是相对包根目录的路径（手机按 `packages/<id>/<path>` 登记）。
+fn collect_package_files(
+    root: &std::path::Path,
+    directory: &std::path::Path,
+    files: &mut Vec<serde_json::Value>,
+    budget: &mut usize,
+) -> Result<(), String> {
+    let entries = std::fs::read_dir(directory).map_err(|error| error.to_string())?;
+    for entry in entries {
+        if files.len() >= PACKAGE_FILES_MAX || *budget == 0 {
+            break;
+        }
+        let entry = entry.map_err(|error| error.to_string())?;
+        let path = entry.path();
+        if path.is_dir() {
+            collect_package_files(root, &path, files, budget)?;
+            continue;
+        }
+        let Ok(relative) = path.strip_prefix(root) else { continue };
+        let relative = relative.to_string_lossy().replace('\\', "/");
+        let Ok(bytes) = std::fs::read(&path) else { continue };
+        if bytes.len() > *budget {
+            continue;
+        }
+        // 文本才收：二进制（图标、字体）在这里解不出来，跳过而不是塞乱码
+        let Ok(text) = String::from_utf8(bytes) else { continue };
+        *budget -= text.len();
+        files.push(json!({ "path": relative, "text": text }));
+    }
+    Ok(())
+}
