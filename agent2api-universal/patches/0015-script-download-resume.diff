+
+/// 带断点续传的下载：每次被掐断都发 `Range: bytes=<已收>-` 接着往后传。
+///
+/// 为什么需要它：这份分发索引约 2.9 MB，`raw.githubusercontent.com` 在部分网络会
+/// 在 2.5–2.8 MiB 处被掐断（实测进度条停在那儿、随后整条操作消失）。没有续传时
+/// 重试只能从 0 开始，于是「获取」看起来永远停在"下载中"。
+///
+/// 收尾判定：拿得到 `Content-Length` 时按"总字节是否够"判断，不够就再续一次；
+/// 拿不到（分块传输）只能认流结束为完成 —— 那种情况至少还有 sha256（若给定）兜底。
+async fn resumed(
+    transport: Transport,
+    url: &str,
+    limit: usize,
+    expected_sha256: Option<&str>,
+) -> Result<Vec<u8>, String> {
+    let mut result: Vec<u8> = Vec::new();
+    let mut last_error = String::new();
+    for _ in 0..ATTEMPTS {
+        let mut headers = match transport {
+            Transport::Official => client::github_headers(),
+            Transport::Public => user_agent(),
+        };
+        if !result.is_empty() {
+            headers.push(("Range".to_string(), format!("bytes={}-", result.len())));
+        }
+        // 建连阶段也要有上限：镜像会"连上但不发数据"，不设上限这里就会一直等。
+        let response = match tokio::time::timeout(
+            std::time::Duration::from_millis(CONNECT_MS),
+            fetch(transport, url, &headers),
+        )
+        .await
+        {
+            Ok(Ok(response)) => response,
+            Ok(Err(error)) => {
+                last_error = error;
+                continue;
+            }
+            Err(_) => {
+                last_error = format!("连接后 {} 秒没有响应", CONNECT_MS / 1000);
+                continue;
+            }
+        };
+        let status = response.status();
+        if !status.is_success() {
+            return Err(format!("下载失败：HTTP {}", status.as_u16()));
+        }
+        if status != reqwest::StatusCode::PARTIAL_CONTENT {
+            // 服务端忽略了 Range（回 200 ⇒ 从头传）：丢掉已收部分，这次的结果为准。
+            result.clear();
+        }
+        let remaining = response.content_length();
+        if remaining.is_some_and(|length| (result.len() as u64).saturating_add(length) > limit as u64)
+        {
+            return Err("下载文件超过允许大小".into());
+        }
+        let target = remaining.map(|length| result.len() as u64 + length);
+        if let Err(error) = drain(response, &mut result, limit).await {
+            last_error = error;
+            continue;
+        }
+        let complete = match target {
+            Some(value) => result.len() as u64 >= value,
+            None => true,
+        };
+        if complete {
+            if let Some(expected) = expected_sha256 {
+                if format!("{:x}", Sha256::digest(&result)) != expected {
+                    return Err("下载文件校验失败，未安装或运行".into());
+                }
+            }
+            return Ok(result);
+        }
+        last_error = format!("传输中断，已收到 {} 字节", result.len());
+    }
+    Err(format!(
+        "下载多次中断（已收到 {} 字节）：{last_error}",
+        result.len()
+    ))
+}
