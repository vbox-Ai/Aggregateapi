+/// 远端宿主会话（iOS：宿主跑在手机里）的出站口。
+///
+/// ── 为什么放在模块级，而不是宿主实例的字段里 ────────────────────
+/// 安装/切换会把脚本宿主实例**换掉**：`switch` 先 `shutdown_packs(HOST_ID)`，
+/// 之后 `prepare` 新建一个实例并重新登记。而 `shutdown()` 会把旧实例标成
+/// `closing`，`ensure()` 明确拒绝复活它 —— 所以"把会话存在实例上"必然在新实例里
+/// 丢失：新实例既没有远端、又起不了子进程（iOS 上没有 Bun，`spawn()` 必然 ENOENT）。
+/// 会话是**面板级**的（一台网关同一时刻只服务一个面板），放这里之后谁先到都行：
+/// 手机先接入，之后新建的宿主实例照常看得见这条会话。
+static REMOTE_SESSION: std::sync::OnceLock<
+    StdMutex<Option<tokio::sync::mpsc::UnboundedSender<proto::Frame>>>,
+> = std::sync::OnceLock::new();
+
+fn remote_session() -> &'static StdMutex<Option<tokio::sync::mpsc::UnboundedSender<proto::Frame>>> {
+    REMOTE_SESSION.get_or_init(|| StdMutex::new(None))
+}
+
+/// 挂上远端宿主会话，交出本会话的出站接收端（由 `GET /api/plugins/host/stream` 取走）。
+///
+/// 重复挂载会替换旧会话：旧通道被丢弃后它的写入会失败（见 `Host::write`），
+/// 不会与新会话串帧。
+pub(crate) fn attach_remote_session(
+) -> Option<tokio::sync::mpsc::UnboundedReceiver<proto::Frame>> {
+    let (sender, receiver) = tokio::sync::mpsc::unbounded_channel();
+    let mut slot = remote_session().lock().ok()?;
+    *slot = Some(sender);
+    Some(receiver)
+}
+
+/// 拆掉远端宿主会话；之后脚本宿主回到子进程路径。
+pub(crate) fn detach_remote_session() {
+    if let Ok(mut slot) = remote_session().lock() {
+        *slot = None;
+    }
+}
+
+fn remote_sender() -> Option<tokio::sync::mpsc::UnboundedSender<proto::Frame>> {
+    remote_session().lock().ok().and_then(|slot| slot.clone())
 }
 
