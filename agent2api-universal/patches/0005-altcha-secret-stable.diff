+/// HMAC 签名密钥：库里没有就现场生成并落库。
+///
+/// ── 为什么必须进程内缓存 ──────────────────────────────────────
+/// 上游版本每次调用都会去 `kv_get`，库不可用（`db()` 还没打开、库被锁、
+/// 目录不可写）就现场随机一把并 `kv_put`——而 `kv_put` 同样在库不可用时
+/// **静默返回**。于是签发 challenge 时用密钥 A、验签时又随机出密钥 B，
+/// 签名必然对不上，登录页永远报「机器人校验无效，请刷新页面重试」。
+/// 全新安装（空库）第一次打开登录页正好落在这个窗口里，所以表现为
+/// 「以前能用、重装后必现」。
+///
+/// 修法：密钥在进程生命周期内只算一次（`OnceLock`），并幂等补写——
+/// 库晚一点可用时把同一把密钥补进去，重启后仍然一致。
 fn secret() -> String {
-    let existing = access::kv_get(KV_SECRET_KEY);
-    if let Some(value) = existing {
-        return value;
+    static CACHE: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    let cached = CACHE.get_or_init(|| {
+        if let Some(value) = access::kv_get(KV_SECRET_KEY).filter(|value| !value.is_empty()) {
+            return value;
+        }
+        let mut buf = [0u8; 32];
+        getrandom::getrandom(&mut buf).expect("系统随机源不可用");
+        buf.iter().map(|b| format!("{b:02x}")).collect()
+    });
+    // 幂等补写：`kv_put` 在库不可用时不报错也不写入，所以每次都比对一次，
+    // 一旦库可用就把这把密钥落库（下一进程直接读库，密钥不再漂移）。
+    if access::kv_get(KV_SECRET_KEY).as_deref() != Some(cached.as_str()) {
+        access::kv_put(KV_SECRET_KEY, cached);
     }
-    let mut buf = [0u8; 32];
-    getrandom::getrandom(&mut buf).expect("系统随机源不可用");
-    let generated: String = buf.iter().map(|b| format!("{b:02x}")).collect();
-    access::kv_put(KV_SECRET_KEY, &generated);
-    generated
+    cached.clone()
 }
 
