+/// 多久没有任何进展就判定为卡死。
+/// 必须大于单次请求的超时（镜像请求现在是 45 秒），否则慢线路会被误伤。
+const STALL_MS: i64 = 180_000;
+
+/// 任务代际：每开始一次任务 +1。卡死判定把状态让给新任务之后，旧任务就**不该再写状态**
+/// （否则它收尾时会把新任务写成"已结束"）。
+fn next_generation() -> u64 {
+    static GENERATION: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    GENERATION.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1
+}
+
+/// 记一次"有进展"（阶段切换、下载字节、等待循环里都调）。
+fn touch(value: &mut Value) {
+    value["progressAt"] = json!(crate::server::logging::now_ms());
+}
+
+/// 本次任务的心跳：只在状态仍属于这一代任务时生效。
+fn heartbeat_if(generation: u64) {
+    if let Ok(mut value) = state().lock() {
+        if value["active"] == true && value["generation"].as_u64() == Some(generation) {
+            touch(&mut value);
+        }
+    }
+}
+
+/// 等"在途请求结束"这一类等待的心跳：它不属于某一次具体的下载，所以不做代际检查。
+fn heartbeat() {
+    if let Ok(mut value) = state().lock() {
+        if value["active"] == true {
+            touch(&mut value);
+        }
+    }
+}
+
+/// 给"自己不报进度的慢步骤"打心跳；guard 掉落即停表。
+///
+/// 这些步骤（下运行时、装依赖）**不经过** stage()/download_progress()，所以它们本身不算进展；
+/// 但它们确实在干活 ⇒ 用一个 10 秒一跳的心跳把它们和"真卡死"区分开。
+struct KeepAlive {
+    stop: std::sync::Arc<std::sync::atomic::AtomicBool>,
+}
+
+impl Drop for KeepAlive {
+    fn drop(&mut self) {
+        self.stop.store(true, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+fn keepalive(generation: u64) -> KeepAlive {
+    let stop = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let flag = stop.clone();
+    crate::spawn_task(async move {
+        while !flag.load(std::sync::atomic::Ordering::Relaxed) {
+            heartbeat_if(generation);
+            tokio::time::sleep(Duration::from_secs(10)).await;
+        }
+    });
+    KeepAlive { stop }
+}
+
+/// 进行中的任务如果长时间没有任何进展，就**当场判定失败**并给出原因。
+///
+/// 为什么在读取状态时判定、而不是起一个后台任务：面板在任务进行中每 1.5 秒轮询一次这个值，
+/// 读取时判定既不用额外的调度，也不会在没人看的时候偷偷改状态。
+/// 判定之后任务变成"已结束的失败" ⇒ 客户端会把它列进「最近失败」，用户终于能看到原因；
+/// `begin()` 也不再被一个卡死的任务永久占住。
+fn stalled(value: &mut Value) {
+    if value["active"] != true {
+        return;
+    }
+    let now = crate::server::logging::now_ms();
+    let last = value["progressAt"]
+        .as_i64()
+        .or_else(|| value["startedAt"].as_i64())
+        .unwrap_or(now);
+    if now.saturating_sub(last) < STALL_MS {
+        return;
+    }
+    let seconds = now.saturating_sub(last) / 1000;
+    value["active"] = json!(false);
+    value["updatedAt"] = json!(now);
+    value["stage"] = json!("failed");
+    value["error"] = json!(format!(
+        "任务已有 {seconds} 秒没有任何进展，已判定为卡死（多半是下载线路中断）。请在「设置 → 自动更新」里换一条出网线路，或稍后重试。"
+    ));
+}
