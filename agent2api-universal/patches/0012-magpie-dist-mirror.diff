+/// 取一个**非 GitHub** 地址的字节（例如 jsDelivr 这类镜像）。
+///
+/// 为什么不能用 `github_bytes`：那条路走的是 GitHub 专用客户端（候选源 / 限速冷却 / 镜像切换），
+/// 对第三方域名不适用。这里用通用的 `fetch_public`，仍然带 UA 与状态码检查。
+pub(super) async fn public_bytes(url: &str, limit: usize) -> Result<Vec<u8>, String> {
+    let headers = vec![("User-Agent".to_string(), "agent2api".to_string())];
+    let response = client::fetch_public(url, &headers, None).await?;
+    if !response.status().is_success() {
+        return Err(format!("镜像返回 HTTP {}", response.status().as_u16()));
+    }
+    let mut stream = response.bytes_stream();
+    let mut bytes = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk.map_err(|error| error.to_string())?;
+        if bytes.len() + chunk.len() > limit { return Err("镜像内容超出大小上限".into()); }
+        bytes.extend_from_slice(&chunk);
+    }
+    Ok(bytes)
 }
 
