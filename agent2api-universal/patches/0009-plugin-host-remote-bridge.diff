+/// 关闭远端宿主会话（面板退出或手机断开）。
+pub async fn close_remote(State(_state): State<ServerState>, _headers: HeaderMap) -> Response {
+    if let Some(host) = script::script_host() {
+        host.detach_remote();
+    }
+    if let Ok(mut slot) = inbox().lock() {
+        *slot = None;
+    }
+    ok_json(json!({ "ok": true }))
+}
