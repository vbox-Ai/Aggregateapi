@@ -116,6 +116,11 @@ pub fn panel_router(state: ServerState) -> Router {
         // any 而不是 get：探针要与登录**同动词**（POST）—— 有的中转按方法
         // 区别对待 Set-Cookie，只测 GET 会误报「cookie 通道完好」
         .route("/api/panel/cookie-probe", any(api::panel::cookie_probe))
+        // 宿主能力表：界面在**登录之前**就要知道本端能干什么
+        // （要不要渲染插件页、订阅内核、桌面专有入口），因此必须挂 public。
+        // 它只描述能力，不含账号/Key/路径；字段口径与 ui/host.js、
+        // mobile/src/host.ts、core/plugin_host 的 exec 闸门严格一致。
+        .route("/api/host", get(api::host::get_host))
         // CatPaw 网页登录的回调路由已随实现搬到插件：它的登录是**双通道**
