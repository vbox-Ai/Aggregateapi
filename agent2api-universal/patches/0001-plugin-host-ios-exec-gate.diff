 use super::process::{self, ExitReport, ProcessRun};
 use super::{Host, Inner, StreamEvent};
 
+/// 当前运行形态能否启动插件子进程、或为脚本插件准备运行时。
+///
+/// ── 为什么需要这道闸门 ────────────────────────────────────
+/// provider 实现已经外置到插件包，插件起不来就等于「所有厂商都不可用」。
+/// 让 spawn 或下载直接失败，用户会看到 `Operation not permitted` 一类的系统错误，
+/// 而 `providers/missing_plugin.rs` 已经约定好可行动文案；两者必须一致。
+///
+/// ── 三种插件形态都要过这关 ────────────────────────────────
+/// 进程插件（`--serve-pack`）、脚本插件（Bun）、wasm 插件；以及脚本插件安装时的
+/// Bun 运行时下载。任一路径绕过它，就会出现「装得上但用不了」。
+///
+/// ── 开关口径 ──────────────────────────────────────────────
+/// · `AGENT2API_NO_EXEC=1`    强制拒绝（容器 / CI 里做「无插件」演示用）
+/// · `AGENT2API_ALLOW_EXEC=1` 强制允许（iOS 越狱 daemon 必须显式声明：
+///   launchd 拉起的 Mach-O 可以 posix_spawn，但只有部署者自己知道它是不是这种形态，
+///   所以不给默认值）
+/// · iOS 未声明 → 拒绝（App 沙盒里内嵌的网关走这条）
+/// · 其它平台 → 允许，行为与打补丁前完全一致
+pub(super) fn exec_blocked() -> Option<&'static str> {
+    let flag = |key: &str| std::env::var(key).map(|v| v.trim() == "1").unwrap_or(false);
+    if flag("AGENT2API_NO_EXEC") {
+        return Some("AGENT2API_NO_EXEC=1");
+    }
+    if flag("AGENT2API_ALLOW_EXEC") {
+        return None;
+    }
+    #[cfg(target_os = "ios")]
+    {
+        return Some("iOS 形态未声明 AGENT2API_ALLOW_EXEC=1");
+    }
+    #[cfg(not(target_os = "ios"))]
+    {
+        None
+    }
+}
