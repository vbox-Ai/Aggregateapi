+    /// 当前运行形态能否启动插件子进程。
+    ///
+    /// ── 为什么需要这个闸门 ────────────────────────────────────
+    /// provider 实现已经外置到插件包，插件起不来就等于「所有厂商都不可用」。
+    /// 直接让 spawn 失败会让用户看到 `Operation not permitted`，而
+    /// `providers/missing_plugin.rs` 已经约定好可行动文案；两者必须一致。
+    ///
+    /// ── 开关口径 ──────────────────────────────────────────────
+    /// · `AGENT2API_NO_EXEC=1`    强制拒绝（容器 / CI 里做「无插件」演示用）
+    /// · `AGENT2API_ALLOW_EXEC=1` 强制允许（iOS 越狱 daemon 必须显式声明：
+    ///   launchd 拉起的 Mach-O 可以 posix_spawn，但只有部署者自己知道它是
+    ///   不是这种形态，所以不给默认值）
+    /// · iOS 未声明 → 拒绝（App 沙盒里内嵌的网关走这条）
+    /// · 其它平台 → 允许，行为与打补丁前完全一致
+    fn exec_blocked() -> Option<&'static str> {
+        let flag = |key: &str| std::env::var(key).map(|v| v.trim() == "1").unwrap_or(false);
+        if flag("AGENT2API_NO_EXEC") {
+            return Some("AGENT2API_NO_EXEC=1");
+        }
+        if flag("AGENT2API_ALLOW_EXEC") {
+            return None;
+        }
+        #[cfg(target_os = "ios")]
+        {
+            return Some("iOS 形态未声明 AGENT2API_ALLOW_EXEC=1");
+        }
+        #[cfg(not(target_os = "ios"))]
+        {
+            None
+        }
+    }
     async fn start(self: &Arc<Self>) -> Result<Vec<proto::ProviderInfo>, String> {
         let _serial = self.starting.lock().await;
         if self.closing.load(Ordering::Acquire) { return Err("插件宿主正在关闭".to_string()); }
@@ -103,6 +134,18 @@ impl Host {
         if self.options.script { super::script::clear_transport(); }
