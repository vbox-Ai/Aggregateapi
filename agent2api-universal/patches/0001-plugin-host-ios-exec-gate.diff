 pub async fn ensure() -> Result<PathBuf, String> {
+    // ── 同一道宿主闸门：iOS / 容器里不该为了装脚本插件去下载 200 MB 的 Bun ──
+    // 判定与 `plugin_host::lifecycle::exec_blocked()` 完全一致（那边拦进程与 wasm，
