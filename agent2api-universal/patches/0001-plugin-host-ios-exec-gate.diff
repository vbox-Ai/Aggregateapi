+            );
+            self.note_failure(&message);
+            self.disabled.store(true, Ordering::Release);
+            return Err(message);
+        }
         let mut command = tokio::process::Command::new(&self.options.exe);
         command.args(&self.options.args)
             .stdin(std::process::Stdio::piped())
