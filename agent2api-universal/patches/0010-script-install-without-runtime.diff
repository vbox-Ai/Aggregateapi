+/// 这支插件**是否真的需要解析依赖**。
+///
+/// ── 为什么单独抽出来 ──────────────────────────────────────────
+/// 阶段 0 的 iOS 形态里，网关侧可能**没有任何 JS 运行时**（bun.rs 的 asset() 没有 ios 分支）。
+/// 那时"要不要拒绝安装"完全取决于这个判定：Magpie dist 发布的是已构建产物
+/// （实测 `dependencies` 为空），没有运行时也能跑；真声明了依赖的包才必须拒绝。
+/// `install` 与 `operations` 共用这一份判定，避免两处各写一遍而分叉。
+pub(super) fn requires_install(package: &super::storage::Package) -> Result<bool, String> {
+    let directory = super::storage::directory(package)?;
+    let manifest: Value = serde_json::from_slice(&std::fs::read(directory.join("package.json")).map_err(|error| error.to_string())?)
+        .map_err(|_| "插件清单无法解析")?;
+    Ok(needs_dependencies(&manifest))
+}
+
+/// 判定本体：只看依赖字段是否**非空**（部署清单里的空对象不算需要装）
+fn needs_dependencies(manifest: &Value) -> bool {
+    ["dependencies", "optionalDependencies", "peerDependencies"].iter()
+        .any(|key| manifest[*key].as_object().is_some_and(|items| !items.is_empty()))
+}
+
 pub(super) async fn install(package: &super::storage::Package, executable: &Path) -> Result<(), String> {
     let directory = super::storage::directory(package)?;
     let manifest: Value = serde_json::from_slice(&std::fs::read(directory.join("package.json")).map_err(|error| error.to_string())?)
         .map_err(|_| "插件清单无法解析")?;
-    if !["dependencies", "optionalDependencies", "peerDependencies"].iter().any(|key| manifest[*key].as_object().is_some_and(|items| !items.is_empty())) {
-        return Ok(());
-    }
+    if !needs_dependencies(&manifest) { return Ok(()); }
     if directory.join(".agent2api-dependencies").is_file() { return Ok(()); }
     super::operations::stage("dependencies", "正在安装提供商插件依赖（不执行安装脚本）");
     let temporary = tempfile::tempdir_in(super::root()).map_err(|error| error.to_string())?;
