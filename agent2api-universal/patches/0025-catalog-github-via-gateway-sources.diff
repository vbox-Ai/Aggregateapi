-    resumed(Transport::Official, url, limit, None).await
+    match resumed(Transport::Public, url, limit, None).await {
+        Ok(bytes) => Ok(bytes),
+        Err(public_error) => resumed(Transport::Official, url, limit, None).await
+            .map_err(|official_error| format!("{official_error}（自动选源失败：{public_error}）")),
+    }
 }
 
