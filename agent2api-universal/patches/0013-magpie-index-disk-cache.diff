+///
+/// TTL 取 6 小时：安装只关心"这支插件有没有发布包、integrity 是多少"，不需要秒级新鲜；
+/// 而这份索引约 2.9 MB，在部分网络（典型是国内直连 raw.githubusercontent.com）会被中途掐断
+/// —— 少下一次就少一次被掐的机会。
+const INDEX_TTL_MS: u64 = 6 * 60 * 60 * 1000;
+/// 索引的**磁盘**缓存文件名（放在网关配置目录下）。
+/// 只做内存缓存不够：手机上网关随 App 重启，内存缓存跟着没了 —— 于是每次重新越狱后又得再下那 2.9 MB。
+const INDEX_FILE: &str = "magpie-dist-index.json";
 static INDEX_CACHE: std::sync::Mutex<Option<(u64, Value)>> = std::sync::Mutex::new(None);
 
 /// 按 `BASE` 的相对路径取字节：先试镜像，再退回 GitHub raw。
@@ -35,13 +41,45 @@
             if now.saturating_sub(*at) < INDEX_TTL_MS { return Ok(cached.clone()); }
         }
     }
+    // 磁盘缓存优先：网关重启后仍然有效（手机上的网关会随 App 重启）。
