+
+/// 索引缓存文件路径（网关配置目录下）。
+fn index_path() -> std::path::PathBuf {
+    crate::server::config::config_dir().join(INDEX_FILE)
+}
+
+/// 读磁盘缓存：文件不存在、过期或解析失败都当作"没缓存"，重新下。
+fn read_cached_index(now: u64) -> Option<Value> {
+    let modified = std::fs::metadata(index_path()).ok()?.modified().ok()?;
+    let age_ms = std::time::SystemTime::now().duration_since(modified).ok()?.as_millis() as u64;
+    if age_ms >= INDEX_TTL_MS { return None; }
+    let bytes = std::fs::read(index_path()).ok()?;
+    let index: Value = serde_json::from_slice(&bytes).ok()?;
+    if index["version"].as_u64() != Some(1) { return None; }
+    if let Ok(mut cache) = INDEX_CACHE.lock() { *cache = Some((now, index.clone())); }
+    Some(index)
+}
+
+/// 写磁盘缓存：失败只留痕，不影响这次安装 —— 缓存是加速手段，不是正确性前提。
+fn write_cached_index(index: &Value) {
+    let path = index_path();
+    if let Some(parent) = path.parent() {
+        if std::fs::create_dir_all(parent).is_err() { return; }
+    }
+    match serde_json::to_vec(index) {
+        Ok(bytes) => { let _ = std::fs::write(&path, bytes); }
+        Err(error) => crate::server::logging::verbose("[Magpie]", &format!("索引缓存写入失败：{error}")),
+    }
 }
 
