+/// 某个地址是否属于「自建插件源」（未设目录地址时恒为 false）。
+pub fn custom_source_allowed(value: &str) -> bool {
+    if custom_catalog_url().is_none() { return false; }
+    let Ok(url) = url::Url::parse(value) else { return false; };
+    let origin = url.origin().ascii_serialization();
+    custom_origins().iter().any(|allowed| *allowed == origin)
+}
