+/// 自建源允许的额外 origin（`AGENT2API_PLUGIN_ASSET_ORIGINS`，逗号分隔）。
+///
+/// 典型用法：目录放自己的网站、资产放 GitHub Releases —— 两者 origin 不同，需要显式列出。
+fn custom_origins() -> Vec<String> {
+    let mut origins = Vec::new();
+    if let Some(url) = custom_catalog_url().and_then(|value| url::Url::parse(&value).ok()) {
+        origins.push(url.origin().ascii_serialization());
+    }
+    if let Ok(list) = std::env::var("AGENT2API_PLUGIN_ASSET_ORIGINS") {
+        for item in list.split(',') {
+            let item = item.trim().trim_end_matches('/');
+            if item.is_empty() { continue; }
+            if let Ok(url) = url::Url::parse(item) {
+                let origin = url.origin().ascii_serialization();
+                if !origins.contains(&origin) { origins.push(origin); }
+            }
+        }
+    }
+    origins
+}
