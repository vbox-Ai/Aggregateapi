+///
+/// 设置后，目录与资产都允许来自该源（目录同源的 origin 自动放行），不再强制官网 CDN。
+/// 不设 = 与上游行为完全一致。
+pub fn custom_catalog_url() -> Option<String> {
+    std::env::var("AGENT2API_PLUGIN_CATALOG_URL")
+        .ok()
+        .map(|value| value.trim().to_string())
+        .filter(|value| value.starts_with("https://") || value.starts_with("http://"))
