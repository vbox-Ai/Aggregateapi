+/// 用于安装（`packages.rs`）与产物见证（`packages/provenance.rs`）——这两处原本都直接调
+/// `install::entry_for_target`，而那个函数在 beta.2 之后恒取 wasm 键，原生包会得到
+/// `None`，表现为「插件包没有为当前平台提供入口」。
+pub(super) fn resolve_entry(manifest: &proto::PackManifest, target: &str) -> Option<String> {
+    if super::wasm::manifest::is_wasm(manifest) {
+        return install::entry_for_target(manifest, target);
+    }
+    if native_allowed() {
+        native_entry(manifest)
     } else {
-        Err(LEGACY_REASON.to_string())
+        None
     }
 }
 
