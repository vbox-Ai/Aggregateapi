+/// 是否允许原生（非 WASM）提供商插件包。
+///
+/// 默认关闭，与上游 beta.2 起的口径一致（官方只发 WASM 包）。独立形态在 iOS 上拿不到
+/// 可执行页，wasmtime 的 JIT 起不来，所以这里留一个显式开关：置
+/// `AGENT2API_ALLOW_NATIVE_PACKS=1` 后，网关按「当前目标三元组」从包清单的 `entry`
+/// 里取原生入口，走既有子进程宿主通道（`HostOptions.exe`）。
+pub(super) fn native_allowed() -> bool {
+    std::env::var("AGENT2API_ALLOW_NATIVE_PACKS")
+        .map(|value| value == "1" || value.eq_ignore_ascii_case("true"))
+        .unwrap_or(false)
+}
+
+/// 包清单里「当前平台」的原生入口（没有则 `None`）。
+///
+/// 不能用 `install::entry_for_target`：那个函数在 beta.2 之后的实现里**忽略** target，
+/// 恒取 `entry["wasm32-unknown-unknown"]`（见 `install.rs:441`）。这里直接查 `entry`。
+/// `host_target()` 在 iOS 上回落成 `aarch64-unknown-linux-gnu`（`rpc.rs:131` 的 `_` 分支），
+/// 而 `scripts/pack-ios-plugins.sh` 正是按这个键写入口，所以精确匹配即可；
+/// 另补一个 `aarch64-apple-ios` 别名，兼容按真实三元组打包的产物。
+pub(super) fn native_entry(manifest: &proto::PackManifest) -> Option<String> {
+    let target = super::host_target();
+    manifest
+        .entry
+        .get(&target)
+        .or_else(|| manifest.entry.get("aarch64-apple-ios"))
+        .cloned()
+}
+
