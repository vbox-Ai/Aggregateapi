+//! 脚本插件宿主源码的 HTTP 面（阶段 0：iOS 上由手机本地运行宿主时取用）。
+//!
+//! ── 为什么由网关提供，而不是手机自带一份 ──────────────────────
+//! 宿主是「网关侧的一等公民」：它跟着网关版本走（`script_files()` 把这些模块
+//! `include_str!` 进二进制）。手机若自带一份，两边迟早漂移，而宿主与网关之间的
+//! NDJSON 协议、帧形状、方法名都是**成对**的 —— 版本不一致会表现成莫名其妙的
+//! 运行期错误，而不是启动失败。所以这里把「网关当前用的那份」原样给出。
+//!
+//! ── 手机拿它做什么 ────────────────────────────────────────────
+//! iOS 上没有 Bun（`script/bun.rs` 的 `asset()` 没有 ios 分支），网关侧起不了脚本
+//! 宿主。手机改为在 Worker 里跑这些源码，插件的网络请求仍经网关出网。
+//!
+//! ── 与 `api::plugins` 的关系 ──────────────────────────────────
+//! 同构：处理函数签名、`ok_json` 的用法照那一份写；路由挂在 `protected` 分组下，
+//! 鉴权由分组负责（见 `http.rs`）。
+
+use agent2api_provider_protocol as proto;
+use axum::body::{Body, Bytes};
+use axum::extract::State;
+use axum::http::{header, HeaderMap, StatusCode};
+use axum::response::{IntoResponse, Response};
+use axum::Json;
+use serde::Deserialize;
+use serde_json::json;
+
+use crate::server::core::plugin_host::{self, script};
+use crate::server::http::ok_json;
+use crate::server::ServerState;
+
+/// 桥上的失败要能一眼看出是哪一层（缺宿主 / 会话没开 / 内部错）
+fn error_response(message: &str, status: StatusCode) -> Response {
+    (status, Json(json!({ "error": message }))).into_response()
+}
+
+/// 返回宿主源码全量（含 `bunfig.toml` / `package.json` 两个小文件）。
+///
+/// 体积很小，一次给全比按文件取更省事，也免掉「手机记不清哪些取过」这类状态。
+/// 协议与宿主版本用 `hostId` 标识。
+pub async fn source(State(_state): State<ServerState>, _headers: HeaderMap) -> Response {
+    let files: Vec<serde_json::Value> = script::script_files()
+        .iter()
+        .map(|(path, text)| json!({ "path": path, "text": text }))
+        .collect();
+    ok_json(json!({ "hostId": script::HOST_ID, "files": files }))
+}
+
+
+// ── 远端宿主桥（iOS：宿主跑在手机里）────────────────────────────────
+//
+// 宿主与网关之间是「一行一个 JSON 帧」的 NDJSON，正常走子进程的 stdin/stdout。
+// iOS 上没有 Bun（`script/bun.rs` 的 `asset()` 没有 ios 分支），宿主改在手机的
+// Worker 里跑，于是同一份协议改走 HTTP：
+//   · 上行：手机把宿主发出的帧 POST 到 /api/plugins/host/frames
+//   · 下行：手机 GET /api/plugins/host/stream，长连接收网关（与插件）发出的帧
+//
+// ── 为什么不用 WebSocket ────────────────────────────────────────
+// 网关的 axum 只开了 multipart（Cargo.toml:80），没有 ws 特性；开特性等于改依赖面。
+// 这两个端点用现成的 `Body::from_stream` 就够（写法照 api/backup_api.rs:158-173）。
+//
+// ── 会话是单例 ──────────────────────────────────────────────────
+// 一台网关同一时刻只服务一个面板（宿主本身也是单实例），所以用一个全局槽持有
+// 出站接收端，由 `GET /stream` 取走。重复 open 会替换旧会话。
+
+/// 远端宿主桥的审计行（落在 `plugin` 类别里，用户导出的日志能看到）。
+///
+/// 宿主跑在手机 WebView 里，它的 stdout / stderr 都在浏览器上下文 —— 网关这边只看得见
+/// 「帧有没有到」。这条链此前一句日志都没有：出问题时分不清「手机没发帧」还是「发了
+/// 没解析出来」，只能靠用户导日志反推。
+fn audit(text: &str) {
+    crate::server::logging::log_with_level("[Plugin]", text, "info");
+}
+
+/// 待取用的下行接收端，连同**会话守卫**：
+/// 守卫随这条接收端一起被 `GET /stream` 取走，再由那条流的闭包持有 ——
+/// 流一结束（手机断开或页面离开），守卫 Drop ⇒ `plugin_host` 里的会话槽被清空。
+/// 不这么做就会留下僵尸会话：槽里有会话、写进去必失败（见 `Host::write`）。
+type RemoteInbox = (
+    plugin_host::RemoteSessionGuard,
+    tokio::sync::mpsc::UnboundedReceiver<proto::Frame>,
+);
+
+static REMOTE_INBOX: std::sync::OnceLock<std::sync::Mutex<Option<RemoteInbox>>> =
+    std::sync::OnceLock::new();
+
+fn inbox() -> &'static std::sync::Mutex<Option<RemoteInbox>> {
+    REMOTE_INBOX.get_or_init(|| std::sync::Mutex::new(None))
+}
+
+/// 打开远端宿主会话：挂上出站口，交由手机发 `init` 完成握手。
+///
+/// ── 为什么不再要求"脚本宿主已存在" ──────────────────────────────
+/// 之前这里先取 `script_host()`（拿不到就 503）。可是脚本宿主实例**只在一次成功的
+/// `prepare` 之后才被登记**，而 `prepare` 又要求"有 Bun 或已接入远端宿主" ——
+/// 于是形成死锁：接入要宿主、宿主要有接入。iOS 上没有 Bun，这一步一次也没成功过，
+/// 每次安装都落到"起子进程"那条路（`spawn()` 空可执行文件 ⇒ ENOENT）。
+/// 现在会话挂在模块级（`plugin_host::attach_remote_session`），与宿主实例解耦：
+/// 谁先到都行 —— 手机先接入，安装时新建的宿主实例直接复用这条会话。
+pub async fn open_remote(State(_state): State<ServerState>, _headers: HeaderMap) -> Response {
+    audit("远端宿主会话：收到 open");
+    let Some((guard, receiver)) = plugin_host::attach_remote_session() else {
+        audit("远端宿主会话：挂载失败（attach_remote_session 返回 None）");
+        return error_response("远端宿主会话挂载失败", StatusCode::INTERNAL_SERVER_ERROR);
+    };
+    if let Ok(mut slot) = inbox().lock() {
+        *slot = Some((guard, receiver));
+    }
+    audit("远端宿主会话：已挂载，等手机取下行流");
+    ok_json(json!({ "hostId": script::HOST_ID }))
+}
+
+#[derive(Deserialize)]
+pub struct FramesBody {
+    /// 宿主发出的帧（与子进程 stdout 上的完全一致，一行一个）
+    lines: Vec<String>,
+}
+
+/// 上行：把手机端宿主发出的帧交给同一套回调处理。
+///
+/// ── 为什么宿主实例缺席时也能走到这里 ────────────────────────────
+/// 手机刚接入、安装还没开始时，手机上那份宿主已经在发启动日志与启动进度事件
+/// （`main.mjs` 把 `console.*` 改写成 `send({ id: 0, event: "log" })`）。这些帧
+/// 没有宿主实例可以投递 —— 事件帧按丢失处理即可；若为此回 503，手机侧会把整条
+/// 上行通道判成失败，接入也跟着失败。
+pub async fn frames(
+    State(_state): State<ServerState>,
+    _headers: HeaderMap,
+    Json(body): Json<FramesBody>,
+) -> Response {
+    let host = script::script_host();
+    let arrived = body.lines.len();
+    let preview = body
+        .lines
+        .iter()
+        .find(|line| !line.trim().is_empty())
+        .map(|line| line.chars().take(160).collect::<String>())
+        .unwrap_or_default();
+    audit(&format!(
+        "上行帧到达：{} 行，宿主实例={}，首行={}",
+        arrived,
+        if host.is_some() { "有" } else { "无" },
+        if preview.is_empty() { "（空）" } else { preview.as_str() }
+    ));
+    // 拼成一个流再按帧读：proto 的读取接口吃的是 AsyncRead（lifecycle.rs:238 就是这么用的），
+    // 逐行自己解析等于重写一遍协议。
+    // 每帧都要带行尾：`proto::read_frame` 读到 EOF 时若缓冲区还剩半截数据，会直接判
+    // 「帧在中途被截断（对端未发完就关闭了）」—— 手机端是把宿主 stdout 的每一行**剥掉 `\n`**
+    // 之后 POST 上来的，`join` 出来的最后一行没有行尾，于是每次上行都以 400 收场
+    // （客户端据此把整条通道判死）。这里统一补一个行尾，与子进程路径逐字节等价。
+    let payload = format!("{}\n", body.lines.join("\n"));
+    let bytes = payload.as_bytes();
+    let mut reader = tokio::io::BufReader::new(bytes);
+    let mut accepted = 0usize;
+    let mut ignored = 0usize;
+    loop {
+        match proto::read_frame(&mut reader).await {
+            Ok(Some(frame)) => match &host {
+                Some(host) => {
+                    host.serve_remote_frame(frame).await;
+                    accepted += 1;
+                }
+                None => {
+                    if matches!(frame.kind(), proto::FrameKind::Event) {
+                        // 启动期的 log / startup 事件：没有宿主可投递，按丢失计
+                        ignored += 1;
+                    } else {
+                        audit("上行帧被拒：这台网关还没有脚本宿主实例（503）");
+                        return error_response(
+                            "这台网关还没有脚本宿主实例（脚本插件未启用或尚未开始安装）",
+                            StatusCode::SERVICE_UNAVAILABLE,
+                        );
+                    }
+                }
+            },
+            Ok(None) => break,
+            Err(error) => {
+                audit(&format!("上行帧解析失败：{error}（本批 {arrived} 行）"));
+                return error_response(
+                    &format!("宿主帧读取失败：{error}"),
+                    StatusCode::BAD_REQUEST,
+                )
+            }
+        }
+    }
+    audit(&format!("上行帧处理完：投递 {accepted} 帧，丢弃事件 {ignored} 帧"));
+    ok_json(json!({ "accepted": accepted, "ignored": ignored }))
+}
+
+/// 下行：把网关（与插件）发出的帧流给手机。
+pub async fn stream(State(_state): State<ServerState>, _headers: HeaderMap) -> Response {
+    let taken = inbox().lock().ok().and_then(|mut slot| slot.take());
+    let Some((guard, receiver)) = taken else {
+        audit("下行流：槽里没有会话（没 open 或已被取走），回 409");
+        return error_response(
+            "远端宿主会话还没打开（手机端要先 POST /api/plugins/host/open）",
+            StatusCode::CONFLICT,
+        );
+    };
+    audit("下行流：会话已交给这条流");
+    // 守卫跟着这条流的闭包：客户端断开 ⇒ 流被丢弃 ⇒ 会话槽自动清空。
+    let body = Body::from_stream(futures::stream::unfold((guard, receiver), |(guard, mut receiver)| async move {
+        match receiver.recv().await {
+            Some(frame) => {
+                // 用同一套写入器编码，保证与子进程路径逐字节一致
+                let mut out: Vec<u8> = Vec::new();
+                match proto::write_frame(&mut out, &frame).await {
+                    Ok(()) => Some((Ok::<_, std::io::Error>(Bytes::from(out)), (guard, receiver))),
+                    // 编码失败：不静默丢帧，把原因作为流错误交给客户端
+                    Err(error) => Some((Err(std::io::Error::other(error.to_string())), (guard, receiver))),
+                }
+            }
+            None => None,
+        }
+    }));
+    Response::builder()
+        .status(StatusCode::OK)
+        .header(header::CONTENT_TYPE, "application/x-ndjson")
+        .header(header::CACHE_CONTROL, "no-store")
+        .body(body)
+        .unwrap_or_else(|_| error_response("下行流构造失败", StatusCode::INTERNAL_SERVER_ERROR))
+}
+
+// ── 插件文件桥（iOS：宿主跑在手机里，插件的文件却在这台网关上）──────────────
+//
+// 手机里的宿主收到 init 之后，会用 `entry.directory` 去读插件的 `package.json` 与入口
+// 文件，而那个目录是**网关本机**的路径（`script/storage.rs::directory`）—— 手机读不到。
+// 所以在把 init 交给宿主之前，手机按包 id 把这些文件取回去、登记进自己的文件表。
+//
+// 只回文本：脚本插件是 JS 包，图标是 URL，不需要字节流；二进制文件（解不出来）与
+// 超出预算的文件直接跳过 —— 漏文件的表现是宿主报错，不是静默成功。
+
+/// 单包最多回多少文件（正常包几十个）
+const PACKAGE_FILES_MAX: usize = 4096;
+/// 单包最多回多少字节（正常包几百 KB）
+const PACKAGE_BYTES_MAX: usize = 8 << 20;
+
+#[derive(Deserialize)]
+pub struct PackageFilesBody {
+    /// 插件包 id（`script/storage.rs` 里的 `Package::id`）
+    id: String,
+}
+
+/// 按包 id 返回该插件包的全部文本文件（相对包根目录的路径 + 内容）。
+pub async fn package_files(
+    State(_state): State<ServerState>,
+    _headers: HeaderMap,
+    Json(body): Json<PackageFilesBody>,
+) -> Response {
+    let id = body.id.trim().to_string();
+    audit(&format!("取插件文件：id={id}"));
+    if id.is_empty() {
+        return error_response("缺少插件包 id", StatusCode::BAD_REQUEST);
+    }
+    let registry = match script::read_registry() {
+        Ok(registry) => registry,
+        Err(error) => {
+            return error_response(
+                &format!("读取脚本插件注册表失败：{error}"),
+                StatusCode::INTERNAL_SERVER_ERROR,
+            )
+        }
+    };
+    let Some(package) = registry.packages.iter().find(|package| package.id == id) else {
+        // 把注册表里的包 id 一起打出来：手机端看到的只是「HTTP 404」，
+        // 到底是路由没挂、还是注册表里确实没有这支，只能靠这行日志分辨。
+        let known: Vec<&str> = registry.packages.iter().map(|package| package.id.as_str()).collect();
+        audit(&format!(
+            "取插件文件失败：注册表里没有 {id}（现有 {} 支：{}）",
+            known.len(),
+            if known.is_empty() { "空".into() } else { known.join(",") }
+        ));
+        return error_response(&format!("没有这支脚本插件：{id}"), StatusCode::NOT_FOUND);
+    };
+    let directory = match script::package_directory(package) {
+        Ok(directory) => directory,
+        Err(error) => return error_response(&error, StatusCode::INTERNAL_SERVER_ERROR),
+    };
+    let mut files: Vec<serde_json::Value> = Vec::new();
+    let mut budget = PACKAGE_BYTES_MAX;
+    if let Err(error) = collect_package_files(&directory, &directory, &mut files, &mut budget) {
+        return error_response(
+            &format!("读取插件文件失败：{error}"),
+            StatusCode::INTERNAL_SERVER_ERROR,
+        );
+    }
+    ok_json(json!({ "id": id, "files": files }))
+}
+
+/// 递归收文本文件：`path` 是相对包根目录的路径（手机按 `packages/<id>/<path>` 登记）。
+fn collect_package_files(
+    root: &std::path::Path,
+    directory: &std::path::Path,
+    files: &mut Vec<serde_json::Value>,
+    budget: &mut usize,
+) -> Result<(), String> {
+    let entries = std::fs::read_dir(directory).map_err(|error| error.to_string())?;
+    for entry in entries {
+        if files.len() >= PACKAGE_FILES_MAX || *budget == 0 {
+            break;
+        }
+        let entry = entry.map_err(|error| error.to_string())?;
+        let path = entry.path();
+        if path.is_dir() {
+            collect_package_files(root, &path, files, budget)?;
+            continue;
+        }
+        let Ok(relative) = path.strip_prefix(root) else { continue };
+        let relative = relative.to_string_lossy().replace('\\', "/");
+        let Ok(bytes) = std::fs::read(&path) else { continue };
+        if bytes.len() > *budget {
+            continue;
+        }
+        // 文本才收：二进制（图标、字体）在这里解不出来，跳过而不是塞乱码
+        let Ok(text) = String::from_utf8(bytes) else { continue };
+        *budget -= text.len();
+        files.push(json!({ "path": relative, "text": text }));
+    }
+    Ok(())
+}
+
+/// 关闭远端宿主会话（面板退出或手机断开）。
+pub async fn close_remote(State(_state): State<ServerState>, _headers: HeaderMap) -> Response {
+    audit("远端宿主会话：收到 close，开始 detach");
+    plugin_host::detach_remote_session();
+    if let Ok(mut slot) = inbox().lock() {
+        *slot = None;
+    }
+    ok_json(json!({ "ok": true }))
+}
