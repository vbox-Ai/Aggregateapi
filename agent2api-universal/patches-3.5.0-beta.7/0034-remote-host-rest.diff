-    /// 写一帧给插件（或远端宿主）。
-    async fn write(&self, frame: proto::Frame) -> std::io::Result<()> {
-        // 远端会话优先：它没有子进程，current_run() 必然是空的。
-        // 通道关闭（手机断开）时如实报断开，不静默丢弃 —— 上层据此收尾。
-        let remote = self.remote.lock().ok().and_then(|slot| slot.as_ref().cloned());
-        if let Some(sender) = remote {
-            return sender.send(frame).map_err(|_| process::disconnected());
-        }
-        let run = self.current_run().ok_or_else(process::disconnected)?;
-        self.write_for_run(frame, run).await
-    }
-
-    /// 挂上远端出站口（手机端宿主接入时调用），交出本会话的出站接收端。
-    ///
-    /// 重复挂载会替换旧会话：旧通道被丢弃后它的写入会失败（见 `write`），
-    /// 不会与新会话串帧。
-    pub(crate) fn attach_remote(
-        &self,
-    ) -> Option<tokio::sync::mpsc::UnboundedReceiver<proto::Frame>> {
-        let (sender, receiver) = tokio::sync::mpsc::unbounded_channel();
-        let mut slot = self.remote.lock().ok()?;
-        *slot = Some(sender);
-        Some(receiver)
-    }
-
-    /// 拆掉远端出站口；之后 `write()` 回到子进程路径。
-    pub(crate) fn detach_remote(&self) {
-        if let Ok(mut slot) = self.remote.lock() {
-            *slot = None;
-        }
-    }
-
-    pub(crate) fn has_remote(&self) -> bool {
-        self.remote.lock().map(|slot| slot.is_some()).unwrap_or(false)
-    }
-
-    /// 处理远端宿主发来的**一个帧**。
-    ///
-    /// 与子进程读循环的差别只有一处：这里没有 `ProcessRun`，也就没有「是不是
-    /// 当代进程」要判断 —— 远端会话的身份就是那条通道本身。
-    pub(crate) async fn serve_remote_frame(&self, frame: proto::Frame) {
-        match frame.kind() {
-            proto::FrameKind::Reply | proto::FrameKind::Error => self.settle(frame),
-            proto::FrameKind::Event => self.handle_event(frame),
-            proto::FrameKind::Request => {
-                let id = frame.id;
-                let reply = match self.serve_request(frame).await {
-                    // 与原行为一致：无方法名的帧不应答
-                    None => return,
-                    Some(Ok(result)) => proto::Frame { id, result: Some(result), ..Default::default() },
-                    Some(Err(error)) => proto::Frame { id, error: Some(error), ..Default::default() },
-                };
-                let _ = self.write(reply).await;
-            }
-            proto::FrameKind::Unknown => {}
-        }
-    }
-
-    async fn write_for_run(&self, frame: proto::Frame, run: Arc<process::ProcessRun>) -> std::io::Result<()> {
-        let stdin = {
-            let guard = self.inner.lock().await;
-            let inner = guard.as_ref().filter(|inner| Arc::ptr_eq(&inner.run, &run))
-                .ok_or_else(process::disconnected)?;
-            inner.stdin.clone()
-        };
-        let mut stdin = stdin.lock_owned().await;
-        // write_all 可能已经写出半帧；调用方取消不能打断共享管道的帧边界。
-        tokio::spawn(async move {
-            if run.retired.load(Ordering::Acquire) || run.failed.load(Ordering::Acquire) {
-                return Err(process::disconnected());
-            }
-            proto::write_frame(&mut *stdin, &frame).await
-        }).await.map_err(|error| std::io::Error::other(format!("插件写入任务未完成：{error}")))?
-    }
