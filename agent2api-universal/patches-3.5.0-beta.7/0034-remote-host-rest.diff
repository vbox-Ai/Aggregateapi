+/// 远端宿主会话（iOS：宿主跑在手机里）的出站口。
+///
+/// ── 为什么放在模块级，而不是宿主实例的字段里 ────────────────────
+/// 安装/切换会把脚本宿主实例**换掉**：`switch` 先 `shutdown_packs(HOST_ID)`，
+/// 之后 `prepare` 新建一个实例并重新登记。而 `shutdown()` 会把旧实例标成
+/// `closing`，`ensure()` 明确拒绝复活它 —— 所以"把会话存在实例上"必然在新实例里
+/// 丢失：新实例既没有远端、又起不了子进程（iOS 上没有 Bun，`spawn()` 必然 ENOENT）。
+/// 会话是**面板级**的（一台网关同一时刻只服务一个面板），放这里之后谁先到都行：
+/// 手机先接入，之后新建的宿主实例照常看得见这条会话。
+type RemoteSender = tokio::sync::mpsc::UnboundedSender<proto::Frame>;
+
+static REMOTE_SESSION: std::sync::OnceLock<StdMutex<Option<(u64, RemoteSender)>>> =
+    std::sync::OnceLock::new();
+
+fn remote_session() -> &'static StdMutex<Option<(u64, RemoteSender)>> {
+    REMOTE_SESSION.get_or_init(|| StdMutex::new(None))
+}
+
+/// 会话代次：每挂载一次加一。
+///
+/// ── 为什么要它 ──────────────────────────────────────────────────
+/// 会话会结束（手机离开插件页、页面重载、宿主崩掉），而"谁先到都行"的全局槽本身
+/// 没有生命周期。手机在一次停留里可能重连多次，旧会话的守卫**不能**把后来者清掉，
+/// 所以守卫只认自己那一代。
+fn next_session() -> u64 {
+    static SESSIONS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    SESSIONS.fetch_add(1, Ordering::Relaxed) + 1
+}
+
+/// 会话守卫：跟着下行流一起活着；流结束（手机断开）时自动清槽。
+///
+/// ── 为什么必须有 ────────────────────────────────────────────────
+/// 没有它会留下"僵尸会话"：手机走了，槽里的发送端还在 ⇒ `has_remote()` 说"有远端"，
+/// 而每一次写入都失败。表现就是点安装立刻报
+/// 「写插件失败: 插件进程已退出或正在关闭」，而且**重进页面照样如此** ——
+/// 槽里躺着的始终是那条死会话。
+pub(crate) struct RemoteSessionGuard(u64);
+
+impl Drop for RemoteSessionGuard {
+    fn drop(&mut self) {
+        detach_session(self.0);
+    }
+}
+
+fn detach_session(generation: u64) {
+    if let Ok(mut slot) = remote_session().lock() {
+        if slot.as_ref().is_some_and(|(id, _)| *id == generation) {
+            *slot = None;
+        }
+    }
+}
+
+/// 挂上远端宿主会话，交出（守卫, 出站接收端）。
+///
+/// 接收端由 `GET /api/plugins/host/stream` 取走；守卫由那条下行流持有。
+/// 重复挂载会替换旧会话：旧通道被丢弃后它的写入会失败（见 `Host::write`），
+/// 不会与新会话串帧。
+pub(crate) fn attach_remote_session() -> Option<(RemoteSessionGuard, tokio::sync::mpsc::UnboundedReceiver<proto::Frame>)> {
+    let (sender, receiver) = tokio::sync::mpsc::unbounded_channel();
+    let generation = next_session();
+    let mut slot = remote_session().lock().ok()?;
+    *slot = Some((generation, sender));
+    Some((RemoteSessionGuard(generation), receiver))
+}
+
+/// 拆掉远端宿主会话（面板显式关闭）；之后脚本宿主回到子进程路径。
+pub(crate) fn detach_remote_session() {
+    if let Ok(mut slot) = remote_session().lock() {
+        *slot = None;
+    }
+}
+
+/// 远端出站口。**顺手做活性检查**：接收端已经没了（手机走了）就清槽并如实返回 `None`，
+/// 让上层回到"没有远端"的分支，而不是往一条死通道里写。
+fn remote_sender() -> Option<RemoteSender> {
+    let (generation, sender) = {
+        let slot = remote_session().lock().ok()?;
+        let (generation, sender) = slot.as_ref()?;
+        (*generation, sender.clone())
+    };
+    if sender.is_closed() {
+        detach_session(generation);
+        return None;
+    }
+    Some(sender)
+}
