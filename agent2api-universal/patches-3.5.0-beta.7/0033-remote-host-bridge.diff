         self.write_for_run(frame, run).await
+    }
+
+    /// 挂上远端出站口（手机端宿主接入时调用），交出本会话的出站接收端。
+    ///
+    /// 重复挂载会替换旧会话：旧通道被丢弃后它的写入会失败（见 `write`），
+    /// 不会与新会话串帧。
+    pub(crate) fn attach_remote(
+        &self,
+    ) -> Option<tokio::sync::mpsc::UnboundedReceiver<proto::Frame>> {
+        let (sender, receiver) = tokio::sync::mpsc::unbounded_channel();
+        let mut slot = self.remote.lock().ok()?;
+        *slot = Some(sender);
+        Some(receiver)
+    }
+
+    /// 拆掉远端出站口；之后 `write()` 回到子进程路径。
+    pub(crate) fn detach_remote(&self) {
+        if let Ok(mut slot) = self.remote.lock() {
+            *slot = None;
+        }
+    }
+
+    pub(crate) fn has_remote(&self) -> bool {
+        self.remote.lock().map(|slot| slot.is_some()).unwrap_or(false)
+    }
