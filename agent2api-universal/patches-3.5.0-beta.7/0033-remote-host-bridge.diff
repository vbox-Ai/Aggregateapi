     async fn write(&self, frame: proto::Frame) -> std::io::Result<()> {
+        // 远端会话优先：它没有子进程，current_run() 必然是空的。
+        // 通道关闭（手机断开）时如实报断开，不静默丢弃 —— 上层据此收尾。
+        let remote = self.remote.lock().ok().and_then(|slot| slot.as_ref().cloned());
+        if let Some(sender) = remote {
