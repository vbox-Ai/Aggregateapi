-fn diagnostic(
-    title: &str,
-    path: &Path,
-    status: &str,
-    hint: &str,
-    stdout: &[u8],
-    stderr: &[u8],
-) -> String {
-    let target = asset().map(|(target, _)| target).unwrap_or("未知");
-    let mut lines = vec![
-        title.to_string(),
-        format!(
-            "运行环境：{} / {}；预期 Bun {VERSION}；下载版本：{target}",
-            std::env::consts::OS,
-            std::env::consts::ARCH
-        ),
-        format!(
-            "检查命令：{} --version",
-            process::redact(&path.to_string_lossy())
-        ),
-        format!("退出详情：{}", process::redact(status)),
-    ];
-    if !hint.is_empty() {
-        lines.push(hint.to_string());
-    }
-    for (label, bytes) in [
-        ("错误输出（stderr，已脱敏）", stderr),
-        ("标准输出（stdout，已脱敏）", stdout),
-    ] {
-        let text = output_summary(bytes);
-        lines.push(format!(
-            "{label}：\n{}",
-            if text.is_empty() {
-                "（无输出）"
-            } else {
-                &text
-            }
-        ));
-    }
-    lines.join("\n")
-}
