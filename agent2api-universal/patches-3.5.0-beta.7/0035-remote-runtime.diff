-async fn probe(path: &Path) -> Result<(), String> {
-    let mut command = tokio::process::Command::new(path);
-    command
-        .arg("--version")
-        .stdin(Stdio::null())
-        .stdout(Stdio::piped())
-        .stderr(Stdio::piped())
-        .kill_on_drop(true)
-        .env_remove("BUN_OPTIONS")
-        .env_remove("NODE_OPTIONS")
-        .env("DO_NOT_TRACK", "1");
-    #[cfg(windows)]
-    command.creation_flags(0x0800_0000);
-    let mut child = command.spawn().map_err(|error| {
-        diagnostic(
-            "Bun 运行时未能启动",
-            path,
-            &format!("系统错误：{error}"),
-            spawn_hint(&error, path),
-            &[],
-            &[],
-        )
-    })?;
-    let stdout_pipe = child.stdout.take();
-    let stderr_pipe = child.stderr.take();
-    let mut stdout = Vec::new();
-    let mut stderr = Vec::new();
-    let result = tokio::time::timeout(STARTUP_TIMEOUT, async {
-        tokio::try_join!(
-            child.wait(),
-            capture(stdout_pipe, &mut stdout),
-            capture(stderr_pipe, &mut stderr),
-        )
-    })
-    .await;
-    match result {
-        Err(_) => {
-            let report = process::reap(&mut child, Duration::ZERO).await;
-            Err(diagnostic(
-                "Bun 启动检查超时（15 秒）",
-                path,
-                &report.description(),
-                "检查未按时完成；请结合下面的输出排查运行环境，不能据此判断为下载失败。",
-                &stdout,
-                &stderr,
-            ))
-        }
-        Ok(Err(error)) => {
-            let report = process::reap(&mut child, Duration::ZERO).await;
-            Err(diagnostic(
-                "Bun 启动检查未完成",
-                path,
-                &format!("{error}；{}", report.description()),
-                "读取运行时输出或等待进程退出时发生错误。",
-                &stdout,
-                &stderr,
-            ))
-        }
-        Ok(Ok((status, (), ()))) => {
-            let report = ExitReport {
-                status: Some(status),
-                ..ExitReport::default()
-            };
-            if !status.success() {
-                return Err(diagnostic(
-                    "Bun 运行时启动后异常退出",
-                    path,
-                    &report.description(),
-                    exit_hint(status, &stderr),
-                    &stdout,
-                    &stderr,
-                ));
-            }
-            if stdout.len() > OUTPUT_BYTES || String::from_utf8_lossy(&stdout).trim() != VERSION {
-                return Err(diagnostic(
-                    "Bun 版本检查未通过",
-                    path,
-                    &report.description(),
-                    "进程正常退出，但版本输出与预期不一致；请检查运行时文件是否被替换。",
-                    &stdout,
-                    &stderr,
-                ));
-            }
-            Ok(())
-        }
-    }
-}
