-            }
-            #[cfg(windows)]
-            if matches!(error.raw_os_error(), Some(193 | 216)) {
-                return "运行时文件格式或处理器架构与当前 Windows 不兼容。";
-            }
-            "请保留系统错误和运行环境信息；目前无法确定具体原因。"
