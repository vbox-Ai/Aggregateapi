<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── 安全版（默认）：只带最小必要权限 ──────────────────────────
	     这一版在真机上已验证「能装、能开」。
	     带 platform-application / no-sandbox / cs.debugger 这类特权时，
	     部分越狱环境（rootless + AppSync）会在 exec 阶段被内核直接杀掉，
	     表现就是"秒退、无弹窗、无 crash log"——所以默认不发这些。 -->
	<key>application-identifier</key>
	<string>com.chiyu.agent2api</string>
	<key>com.apple.developer.team-identifier</key>
	<string>CHIYU000000</string>
	<key>get-task-allow</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>com.chiyu.agent2api</string>
	</array>
</dict>
</plist>
