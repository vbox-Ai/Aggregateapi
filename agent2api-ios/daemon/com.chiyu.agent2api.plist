<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Supervisor 常驻；网关本身由 App 前台/后台控制。
	     Supervisor 不绑 3065，只绑 127.0.0.1:3066 控制口。 -->
	<key>Label</key>
	<string>com.chiyu.agent2api</string>

	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/local/bin/agent2api-supervisor</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT2API_PROXY_HOME</key>
		<string>/var/mobile/Library/agent2api</string>
		<key>HOME</key>
		<string>/var/mobile/Library/agent2api</string>
		<key>AGENT2API_UI_DIR</key>
		<string>/var/jb/usr/local/share/agent2api/ui</string>
		<key>AGENT2API_SERVER_BIN</key>
		<string>/var/jb/usr/local/bin/agent2api-server</string>
		<key>AGENT2API_HOST</key>
		<string>127.0.0.1</string>
		<key>AGENT2API_PROXY_PORT</key>
		<string>3065</string>
		<key>AGENT2API_SUPERVISOR_PORT</key>
		<string>3066</string>
		<key>AGENT2API_ALLOW_EXEC</key>
		<string>1</string>
		<key>AGENT2API_INPROC</key>
		<string>1</string>
		<key>AGENT2API_ALLOW_UNSIGNED_PLUGIN_INSTALL</key>
		<string>1</string>
		<key>AGENT2API_DEPLOY</key>
		<string>ios</string>
		<key>AGENT2API_SELF_UPDATE</key>
		<string>0</string>
		<key>AGENT2API_VERBOSE</key>
		<string>0</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/var/mobile/Library/agent2api/supervisor.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Library/agent2api/supervisor.log</string>

	<key>AbandonProcessGroup</key>
	<false/>
	<key>LowPriorityIO</key>
	<false/>
</dict>
</plist>
