<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── 这个 plist 承担 Android 模块里三个脚本的全部职责 ────────────
	     service.sh / boot-completed.sh → RunAtLoad
	     supervisor.sh（崩溃自恢复 + 退避） → KeepAlive{SuccessfulExit=false} + ThrottleInterval
	     control.sh status/restart        → launchctl kickstart -k / print
	     ============================================================ -->
	<key>Label</key>
	<string>com.chiyu.agent2api</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/var/jb/usr/local/bin/agent2api-launch</string>
		<string>/var/jb/usr/local/bin/agent2api-server</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- 数据目录：与 App 共享（App 只读面板，不写库） -->
		<key>AGENT2API_PROXY_HOME</key>
		<string>/var/mobile/Library/agent2api</string>
		<key>HOME</key>
		<string>/var/mobile/Library/agent2api</string>
		<!-- 面板静态目录：ui/ 整套拷到 /var/jb/usr/local/share/agent2api/ui -->
		<key>AGENT2API_UI_DIR</key>
		<string>/var/jb/usr/local/share/agent2api/ui</string>
		<!-- 只监听回环：面板/API 都从本机 App 或 SSH 隧道访问 -->
		<key>AGENT2API_HOST</key>
		<string>127.0.0.1</string>
		<key>AGENT2API_PROXY_PORT</key>
		<string>3065</string>
		<key>AGENT2API_CAPTCHA_ENABLED</key>
		<string>0</string>
		<!-- 机器人校验默认关：面板只监听 127.0.0.1，装机首次登录时
		     WKWebView 里求解 PoW 容易失败（报「机器人校验无效」），
		     真正的门槛是账号口令。需要时可在面板设置里再打开。 -->
		<!-- 必须为 0：自更新会下载 glibc ELF 覆盖自身，iOS 上直接砖 -->
		<key>AGENT2API_SELF_UPDATE</key>
		<string>0</string>
		<!-- iOS 上插件以独立进程运行：必须显式声明允许 spawn（网关闸门检查这项） -->
		<key>AGENT2API_ALLOW_EXEC</key>
		<string>1</string>
		<!-- 自建/二开插件源：允许“补齐插件”自动安装未签名包。
		     默认关闭；这里显式打开，否则镜像下载会被官方签名校验拒绝。 -->
		<key>AGENT2API_ALLOW_UNSIGNED_PLUGIN_INSTALL</key>
		<string>1</string>
		<key>AGENT2API_VERBOSE</key>
		<string>0</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- 始终由 launchd 保住 launcher；launcher 再决定何时 exec daemon。
	     这样旧网关先死、端口释放后，新 daemon 会自动接管。 -->
	<key>KeepAlive</key>
	<true/>

	<!-- 退避下限（launchd 原生节流，取代 supervisor.sh 的 3s→60s 指数退避） -->
	<key>ThrottleInterval</key>
	<integer>5</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<!-- 以 root 身份跑（不写 UserName 即默认 root）。
	     曾经的 UserName=mobile 会踩两个坑：
	       · RootHide 的 .jbroot-* 与数据目录由 root 布局，mobile 起不来库，
	         日志里就是「[Storage] 数据库不可用」「[Config] 保存失败」；
	       · 面板是 WKWebView 走 HTTP，并不需要 App 直接读 SQLite。
	     3065 是高位端口，root/mobile 都能绑。 -->

	<key>StandardOutPath</key>
	<string>/var/mobile/Library/agent2api/server.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Library/agent2api/server.log</string>

	<key>AbandonProcessGroup</key>
	<false/>

	<!-- 不做 ResourceUsage 限制：网关要开几十条出站长连接 -->
	<key>LowPriorityIO</key>
	<false/>
</dict>
</plist>
